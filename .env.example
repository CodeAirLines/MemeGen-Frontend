# Frontend Environment Configuration Example
# Copy this file to .env.local for local overrides
# DO NOT commit real secrets or credentials to source control

# Backend API Base URL (provided by Nithish)
VITE_API_BASE_URL=https://api.memegen.example.com/api/v1

# Application Environment (development, staging, production)
VITE_APP_ENV=development

# Optional Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_MOCK_API_FALLBACK=true

# AI Assistant Backend Flag (Day 6)
# Default is false (uses curated local suggestions in Demo Mode).
# Set to true only when Nithish has deployed the POST /api/v1/ai/generate-captions endpoint.
VITE_ENABLE_AI_BACKEND=false
